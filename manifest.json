{
  "manifest_version": 3,
  "name": "Read Aloud — Page Reader",
  "version": "1.0.0",
  "description": "Read the current page aloud paragraph by paragraph with highlighting. Uses an Edge TTS server by default and supports browser voices.",
  "permissions": ["storage", "offscreen", "contextMenus", "activeTab", "scripting"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "read-aloud-start-visible": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Start reading from the first paragraph visible on screen"
    }
  },
  "action": {
    "default_title": "Read Aloud",
    "default_icon": {
      "16": "data/icons/16.png",
      "32": "data/icons/32.png",
      "48": "data/icons/48.png",
      "64": "data/icons/64.png"
    }
  },
  "options_ui": {
    "open_in_tab": true,
    "page": "data/options/options.html"
  },
  "icons": {
    "16": "data/icons/16.png",
    "32": "data/icons/32.png",
    "48": "data/icons/48.png",
    "64": "data/icons/64.png",
    "128": "data/icons/128.png"
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "all_frames": false,
    "run_at": "document_idle",
    "css": ["data/content_script/reader.css"],
    "js": ["data/content_script/reader.js"]
  }]
}
